{
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo dev --filter=@dnd/app",
    "check:authored-id-dispatch": "node scripts/check-authored-id-dispatch-boundary.cjs",
    "check:character-sheet-runtime-split": "node scripts/audit-character-sheet-runtime-split.mjs",
    "check:surface-class-json-sync": "node scripts/check-surface-content-json-sync.cjs",
    "check:qa-generated-identity": "python3 scripts/qa/generate_assertions.py --self-test",
    "check:mbt-driver-closure": "node scripts/check-mbt-driver-closure.cjs",
    "check:test-lane-hygiene": "node scripts/check-mbt-test-lanes.cjs test-lane-hygiene",
    "check:mbt-script-inventory": "node scripts/check-mbt-test-lanes.cjs mbt-script-inventory",
    "check:qnt-inventory": "node scripts/check-qnt-inventory.cjs",
    "check:qnt-run-block-separation": "node scripts/check-qnt-run-block-separation.cjs",
    "check:reducer-route-connectors": "node scripts/check-reducer-route-connectors.cjs",
    "raw-coverage:check": "node scripts/raw-coverage-check.cjs",
    "raw-coverage:check:self-test": "node scripts/raw-coverage-check.cjs --self-test",
    "rules-kernel-coverage:check": "node scripts/rules-kernel-coverage-check.cjs",
    "rules-kernel-coverage:check:self-test": "node scripts/rules-kernel-coverage-check.cjs --self-test",
    "cleanroom-branch-coverage:check": "node scripts/cleanroom-branch-coverage-check.cjs",
    "cleanroom-branch-coverage:check:self-test": "node scripts/cleanroom-branch-coverage-check.cjs --self-test",
    "cleanroom-sync:check": "node scripts/sync-cleanroom-input.cjs --self-test",
    "cleanroom-scaffold:check": "node scripts/render-cleanroom-scaffold.cjs --self-test",
    "cleanroom-refresh:package": "node scripts/package-cleanroom-refresh.cjs",
    "cleanroom-harness:check": "node scripts/check-cleanroom-harness.cjs --self-test",
    "level-lt4-choice-closure:check": "node scripts/level-lt4-choice-closure-check.cjs",
    "sdk-raw-integration-inventory:check": "node scripts/sdk-raw-integration-inventory.cjs",
    "unit-profile-coverage:check": "node scripts/unit-profile-coverage-check.cjs",
    "unit-profile-coverage:check:self-test": "node scripts/unit-profile-coverage-check.cjs --self-test",
    "lint": "pnpm --filter @dnd/mcp lint && pnpm --filter @dnd/app lint",
    "circular": "pnpm --filter @dnd/mcp circular && pnpm --filter @dnd/app circular",
    "quality": "pnpm check:authored-id-dispatch && pnpm check:character-sheet-runtime-split && pnpm check:surface-class-json-sync && pnpm check:qa-generated-identity && pnpm check:mbt-driver-closure && pnpm check:test-lane-hygiene && pnpm check:mbt-script-inventory && pnpm check:qnt-inventory && pnpm check:qnt-run-block-separation && pnpm check:reducer-route-connectors && pnpm rules-kernel-coverage:check && pnpm cleanroom-branch-coverage:check && pnpm cleanroom-sync:check && pnpm cleanroom-scaffold:check && pnpm cleanroom-harness:check && pnpm unit-profile-coverage:check && pnpm sdk-raw-integration-inventory:check && pnpm lint && pnpm circular && pnpm typecheck",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "turbo": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
