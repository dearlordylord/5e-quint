{
  "private": true,
  "imports": {
    "#dnd-package-effect-runtime": "./scripts/package-effect-runtime.ts"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "deploy:mcp:dokku-staging": "operations/public-mcp/deploy-dokku.sh staging",
    "deploy:mcp:dokku-production": "operations/public-mcp/deploy-dokku.sh production",
    "configure:mcp:dokku-memory": "operations/public-mcp/configure-dokku-memory-safety.sh",
    "verify:mcp:dokku-publication": "operations/public-mcp/verify-dokku-publication.sh",
    "raw-swarm:catalogue": "mise exec -- pnpm exec tsx scripts/raw-swarm/scenario-catalogue-cli.ts",
    "raw-swarm:model:trial": ". scripts/resource-lock-owner.sh && with_resource_lock_owner scripts/raw-swarm/with-model-lane-lock.sh trial node scripts/raw-swarm/run-model-backed.mjs trial",
    "raw-swarm:model:campaign": ". scripts/resource-lock-owner.sh && with_resource_lock_owner scripts/raw-swarm/with-model-lane-lock.sh campaign node scripts/raw-swarm/run-model-backed.mjs campaign",
    "prepare": "husky",
    "dev": "turbo dev --filter=@dnd/app",
    "prototype:tactical-space": "pnpm --filter @dnd/tactical-space-cli-prototype start",
    "check:authored-id-dispatch": "node scripts/check-authored-id-dispatch-boundary.cjs",
    "check:battle-runtime-import-ownership": "node scripts/check-battle-runtime-import-ownership.cjs",
    "check:battle-runtime-test-support-boundary": "node scripts/check-battle-runtime-test-support-boundary.cjs",
    "check:character-sheet-runtime-split": "node scripts/audit-character-sheet-runtime-split.mjs",
    "check:surface-content-publication": "pnpm check:surface-unit-aggregate && pnpm check:surface-stat-block-aggregate && node scripts/check-surface-content-json-sync.cjs",
    "check:surface-publication-delta": "pnpm exec tsx scripts/verify-surface-publication-delta.ts",
    "verify:effect3-baseline": "pnpm check:effect4-oracle-delta",
    "audit:effect4-oracle-delta": "pnpm exec tsx scripts/effect4-oracle-delta.ts audit",
    "check:effect4-oracle-delta": "pnpm exec tsx scripts/effect4-oracle-delta.ts verify",
    "check:effect4-oracle-delta:self-test": "pnpm exec vitest run scripts/effect4-oracle-delta.test.ts --pool=threads --maxWorkers=1",
    "check:effect4-certification-typecheck": "tsc -p scripts/effect4-certification.tsconfig.json --noEmit",
    "smoke:effect4-clean-consumer": "pnpm exec tsx scripts/effect4-clean-consumer-smoke.ts",
    "check:effect4-cohort:self-test": "node scripts/check-effect4-cohort.mjs --self-test",
    "check:effect4-cohort": "node scripts/check-effect4-cohort.mjs --project .",
    "check:surface-stat-block-aggregate": "pnpm exec tsx scripts/check-srd-stat-block-aggregate.ts",
    "check:surface-unit-aggregate": "pnpm exec tsx scripts/check-srd-unit-aggregate.ts",
    "check:srd-stat-block-catalog": "pnpm exec tsx scripts/check-srd-stat-block-catalog.ts",
    "check:stat-block-procedure-pressure": "pnpm exec tsx scripts/stat-block-procedure-pressure.ts",
    "check:stat-block-procedure-pressure:self-test": "pnpm exec tsx scripts/stat-block-procedure-pressure.ts --self-test",
    "check:stat-block-restricted-invocation-deltas": "pnpm exec tsx scripts/stat-block-restricted-invocation-deltas.ts",
    "check:stat-block-restricted-invocation-deltas:self-test": "pnpm exec tsx scripts/stat-block-restricted-invocation-deltas.ts --self-test",
    "check:stat-block-execution-reconciliation": "node scripts/stat-block-execution-reconciliation.cjs",
    "check:stat-block-execution-reconciliation:self-test": "node scripts/stat-block-execution-reconciliation.cjs --self-test",
    "check:cleanroom-provenance": "node scripts/check-cleanroom-provenance.cjs",
    "check:markdown-links": "node scripts/check-markdown-links.cjs --self-test && node scripts/check-markdown-links.cjs",
    "check:surface-publication-typecheck": "tsc -p scripts/surface-publication.tsconfig.json --noEmit",
    "check:surface-publication-self-test": ". scripts/resource-lock-owner.sh && with_resource_lock_owner scripts/with-broad-workspace-lock.sh pnpm run check:surface-publication-self-test:body",
    "check:surface-publication-self-test:body": "scripts/assert-resource-lock.sh broad && pnpm exec vitest run scripts/check-surface-content-json-sync.test.ts scripts/srd-unit-aggregate.test.ts scripts/srd-stat-block-aggregate.test.ts scripts/srd521-stat-block-parity.test.ts scripts/check-srd-stat-block-aggregate.test.ts scripts/check-srd-stat-block-catalog.test.ts --pool=threads --maxWorkers=1",
    "generate:surface-unit-aggregate": "pnpm exec tsx scripts/generate-srd-unit-aggregate.ts",
    "generate:surface-stat-block-aggregate": "pnpm exec tsx scripts/generate-srd-stat-block-aggregate.ts",
    "generate:surface-publication": "pnpm generate:surface-unit-aggregate && pnpm generate:surface-stat-block-aggregate && pnpm exec tsx scripts/generate-surface-publication.ts",
    "generate:stat-block-procedure-pressure": "pnpm exec tsx scripts/stat-block-procedure-pressure.ts --write",
    "generate:stat-block-execution-reconciliation": "node scripts/stat-block-execution-reconciliation.cjs --write",
    "generate:surface-portable-cases": "pnpm exec tsx scripts/generate-surface-portable-cases.ts",
    "check:surface-class-json-sync": "pnpm check:surface-content-publication",
    "check:mbt-driver-closure": "node scripts/check-mbt-driver-closure.cjs",
    "check:qnt-proof-closure": "node scripts/check-qnt-proof-closure.cjs --self-test && node scripts/check-qnt-proof-closure.cjs",
    "check:qnt-proof-closure:self-test": "node scripts/check-qnt-proof-closure.cjs --self-test",
    "check:qnt-proof-harness": "pnpm exec vitest run scripts/qnt-proof-harness.test.ts --pool=threads --maxWorkers=1",
    "check:qnt-proof-timing-report": "node scripts/qnt-proof-timing-report.cjs --self-test",
    "check:test-lane-hygiene": "node scripts/check-mbt-test-lanes.cjs test-lane-hygiene",
    "check:mbt-script-inventory": "node scripts/check-mbt-test-lanes.cjs mbt-script-inventory",
    "check:qnt-inventory": "node scripts/check-qnt-inventory.cjs",
    "check:qnt-run-block-separation": "node scripts/check-qnt-run-block-separation.cjs --self-test && node scripts/check-qnt-run-block-separation.cjs",
    "check:resource-lock": "node scripts/resource-lock-self-test.cjs",
    "check:raw-swarm-lane-hygiene": "node scripts/raw-swarm/check-lane-hygiene.cjs",
    "check:raw-swarm-deterministic": ". scripts/resource-lock-owner.sh && with_resource_lock_owner scripts/with-broad-workspace-lock.sh pnpm run check:raw-swarm-deterministic:body",
    "check:raw-swarm-deterministic:body": "env -u NODE_OPTIONS RAW_SWARM_EXECUTION_LANE=deterministic node scripts/raw-swarm/run-deterministic-check.cjs",
    "proof:qnt": ". scripts/resource-lock-owner.sh && with_resource_lock_owner scripts/with-mbt-lock.sh pnpm run proof:qnt:body",
    "proof:qnt:body": "scripts/assert-resource-lock.sh mbt && pnpm check:qnt-inventory && pnpm check:mbt-driver-closure && pnpm check:qnt-proof-closure && pnpm --filter @dnd/battle-runtime test:qnt-proofs:body && pnpm --filter @dnd/shared-algebras proof:quint:body && pnpm --filter @dnd/character-creation-runtime test:qnt-slice:body",
    "raw-coverage:check": "node scripts/raw-coverage-check.cjs",
    "raw-coverage:check:self-test": "node scripts/raw-coverage-check.cjs --self-test",
    "rules-kernel-coverage:check": "node scripts/rules-kernel-coverage-check.cjs --self-test && node scripts/rules-kernel-coverage-check.cjs",
    "rules-kernel-coverage:check:self-test": "node scripts/rules-kernel-coverage-check.cjs --self-test",
    "level-lt4-choice-closure:check": "node scripts/level-lt4-choice-closure-check.cjs",
    "sdk-raw-integration-inventory:check": "node scripts/sdk-raw-integration-inventory.cjs",
    "unit-profile-coverage:check": "node scripts/unit-profile-coverage-check.cjs --self-test && node scripts/unit-profile-coverage-check.cjs",
    "unit-profile-coverage:check:self-test": "node scripts/unit-profile-coverage-check.cjs --self-test",
    "gh381-registry-path-manifest:check": "node scripts/gh381-registry-path-manifest-self-test.cjs && node scripts/gh381-registry-path-manifest.cjs",
    "gh381-registry-path-manifest:write": "node scripts/gh381-registry-path-manifest.cjs --write",
    "check:workspace-quality-inventory": "node scripts/workspace-quality-harness.mjs --self-test",
    "lint": "pnpm lint:eslint && prettier --check \"packages/**/*.{ts,tsx,mts,cts,js,mjs,cjs}\" \"scripts/**/*.{ts,tsx,mts,cts,js,mjs,cjs}\" eslint.config.mjs eslint.complexity.config.mjs vitest.config.ts && prettier --check --parser json .madgerc cyclomatic-complexity-baseline.json",
    "lint:eslint": "eslint . --max-warnings=0 --report-unused-disable-directives",
    "check:complexity": "node scripts/workspace-quality-harness.mjs complexity",
    "check:complexity:self-test": "pnpm exec vitest run scripts/cyclomatic-complexity-policy.test.ts scripts/cyclomatic-complexity-identities.test.ts --pool=threads --maxWorkers=1",
    "check:complexity:prune": "node scripts/workspace-quality-harness.mjs complexity:prune",
    "circular": "node scripts/workspace-quality-harness.mjs circular",
    "duplication": "node scripts/workspace-quality-harness.mjs duplication",
    "build": ". scripts/resource-lock-owner.sh && with_resource_lock_owner scripts/with-broad-workspace-lock.sh pnpm run build:turbo",
    "build:turbo": "scripts/assert-resource-lock.sh broad && turbo build --concurrency=1",
    "coverage": ". scripts/resource-lock-owner.sh && with_resource_lock_owner scripts/with-broad-workspace-lock.sh pnpm run coverage:body",
    "coverage:body": "scripts/assert-resource-lock.sh broad && node scripts/workspace-quality-harness.mjs coverage",
    "quality": "node scripts/quality-milestone-guidance.cjs",
    "quality:milestone": ". scripts/resource-lock-owner.sh && with_resource_lock_owner scripts/with-broad-workspace-lock.sh pnpm run quality:body",
    "quality:body": "scripts/assert-resource-lock.sh broad && node scripts/workspace-quality-harness.mjs milestone",
    "typecheck": ". scripts/resource-lock-owner.sh && with_resource_lock_owner scripts/with-broad-workspace-lock.sh pnpm run typecheck:turbo",
    "typecheck:turbo": "scripts/assert-resource-lock.sh broad && turbo typecheck --concurrency=1",
    "test": ". scripts/resource-lock-owner.sh && with_resource_lock_owner scripts/with-broad-workspace-lock.sh pnpm run test:turbo",
    "test:turbo": "scripts/assert-resource-lock.sh broad && turbo test --concurrency=1 -- --maxWorkers=1",
    "check:opaque-oracle-schema-sync": "pnpm --filter @dnd/opaque-oracle check:schema-sync",
    "check:opaque-oracle-corpus": "pnpm --filter @dnd/opaque-oracle check:corpus",
    "build:opaque-oracle": "pnpm --filter @dnd/opaque-oracle build",
    "check:opaque-oracle-distribution": "pnpm --filter @dnd/opaque-oracle check-distribution",
    "generate:opaque-oracle-schemas": "pnpm --filter @dnd/opaque-oracle generate:schemas",
    "generate:opaque-oracle-corpus": "pnpm --filter @dnd/opaque-oracle generate:corpus",
    "write:opaque-oracle-corpus": "pnpm --filter @dnd/opaque-oracle write:corpus"
  },
  "devDependencies": {
    "@dnd/battle-runtime": "workspace:*",
    "@dnd/character-creation-runtime": "workspace:*",
    "@dnd/character-sheet-runtime": "workspace:*",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "^9.39.4",
    "@informalsystems/quint": "0.31.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "22.19.15",
    "@typescript-eslint/parser": "^8.57.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.27.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "3.23.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "redis": "6.2.1",
    "tsx": "^4.21.0",
    "turbo": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "better-call@1.4.0": "patches/better-call@1.4.0.patch"
    }
  },
  "lint-staged": {
    "*.{cjs,css,cts,html,js,jsx,json,md,mjs,mts,scss,ts,tsx}": "prettier --write",
    "!(*pnpm-lock).{yaml,yml}": "prettier --write"
  }
}
