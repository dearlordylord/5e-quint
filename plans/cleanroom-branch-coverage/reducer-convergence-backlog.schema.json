          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diagnosticReplayTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "title",
        "status",
        "sourcePaths",
        "routeEvidence",
        "branchActions",
        "sampledInputWitnesses",
        "acceptance",
        "targetStateOwnerNotes",
        "forbiddenShortcuts",
        "verification"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "blocked",
            "ready",
            "applied",
            "deferred"
          ]
        },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "routeEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/routeEvidence"
          }
        },
        "branchActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sampledInputWitnesses": {
          "type": "array",
