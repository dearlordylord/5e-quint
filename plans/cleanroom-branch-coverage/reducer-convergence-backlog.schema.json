{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reducer-convergence-backlog.schema.json",
  "title": "Reducer convergence backlog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaPath",
    "generatedBy",
    "denominator",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "schemaPath": {
      "const": "plans/cleanroom-branch-coverage/reducer-convergence-backlog.schema.json"
    },
    "generatedBy": {
      "type": "string",
      "minLength": 1
    },
    "denominator": {
      "$ref": "#/$defs/denominator"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/backlogRow"
      }
    }
  },
  "$defs": {
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "totalDrivers",
        "battleLaneDrivers",
        "ruleCoreComponentDrivers",
        "totalBranchObligations",
        "battleLaneBranchObligations",
        "ruleCoreComponentBranchObligations",
        "laneCounts",
        "laneBranchObligations",
        "diagnosticBattleDrivers",
        "diagnosticReducerRoutedDrivers",
        "routeClassCounts",
        "sourceCitations"
      ],
      "properties": {
        "tag": {
          "const": "source-derived-driver-denominator"
        },
        "totalDrivers": {
          "type": "integer",
          "minimum": 0
        },
        "battleLaneDrivers": {
          "type": "integer",
          "minimum": 0
        },
        "ruleCoreComponentDrivers": {
          "type": "integer",
          "minimum": 0
        },
        "totalBranchObligations": {
          "type": "integer",
          "minimum": 0
        },
        "battleLaneBranchObligations": {
          "type": "integer",
          "minimum": 0
        },
        "ruleCoreComponentBranchObligations": {
          "type": "integer",
          "minimum": 0
        },
        "laneCounts": {
          "$ref": "#/$defs/countsByLane"
        },
        "laneBranchObligations": {
          "$ref": "#/$defs/countsByLane"
        },
        "diagnosticBattleDrivers": {
          "type": "integer",
          "minimum": 0
        },
        "diagnosticReducerRoutedDrivers": {
          "type": "integer",
          "minimum": 0
        },
        "routeClassCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog-after-substrate",
            "component-first",
            "reducer-routed",
            "replay-refresh-only"
          ],
          "properties": {
            "catalog-after-substrate": {
              "type": "integer",
              "minimum": 0
            },
            "component-first": {
              "type": "integer",
              "minimum": 0
            },
            "reducer-routed": {
              "type": "integer",
              "minimum": 0
            },
            "replay-refresh-only": {
              "type": "integer",
              "minimum": 0
            },
            "source-qnt-corpus-blocker": {
              "type": "integer",
              "minimum": 0
            },
            "substrate-first": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "sourceCitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceCitation"
          }
        }
      }
    },
    "sourceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPath",
        "fact"
      ],
      "properties": {
        "artifactPath": {
          "type": "string",
          "minLength": 1
        },
        "fact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "countsByLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creation",
        "sheet",
        "handoff",
        "battle",
        "rules-core"
      ],
      "properties": {
        "creation": {
          "type": "integer",
          "minimum": 0
        },
        "sheet": {
          "type": "integer",
          "minimum": 0
        },
        "handoff": {
          "type": "integer",
          "minimum": 0
        },
        "battle": {
          "type": "integer",
          "minimum": 0
        },
        "rules-core": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "backlogRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driverPath",
        "lane",
        "routeClass",
        "connectorPaths",
        "connectorBlockerId",
        "durableOwner",
        "ownerClassification",
        "sourceTaskId",
        "targetTaskId",
        "status",
        "blockerId"
      ],
      "properties": {
        "driverPath": {
          "type": "string",
          "pattern": "^packages/(battle-runtime|character-battle-runtime|character-creation-runtime|character-sheet-runtime)/.+\\.mbt\\.qnt$"
        },
        "lane": {
          "enum": [
            "creation",
            "sheet",
            "handoff",
            "battle",
            "rules-core"
          ]
        },
        "routeClass": {
          "enum": [
            "reducer-routed",
            "component-first",
            "substrate-first",
            "catalog-after-substrate",
            "replay-refresh-only",
            "source-qnt-corpus-blocker"
          ]
        },
        "connectorPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "connectorBlockerId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "durableOwner": {
          "type": "string",
          "minLength": 1
        },
        "ownerClassification": {
          "enum": [
            "durable-owner",
            "component-owner",
            "owner-todo",
            "source-blocker"
          ]
        },
        "sourceTaskId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "targetTaskId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "targetTaskIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "pending",
            "blocked",
            "ready",
            "applied",
            "deferred"
          ]
        },
        "blockerId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "characterCreationFillBatchTasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/characterCreationFillBatchTask"
          }
        },
        "sessionBattleEntryTasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sessionBattleEntryTask"
          }
        },
        "settlementRestOwnerTasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/settlementRestOwnerTask"
          }
        },
        "diagnosticReplayTasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticReplayTask"
          }
        }
      }
    },
    "characterCreationFillBatchTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "title",
        "status",
        "sourcePaths",
        "semanticEvidence",
        "routeEvidence",
        "branchActions",
        "acceptance",
        "targetStateOwnerNotes",
        "forbiddenShortcuts",
        "verification"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "blocked",
            "ready",
            "applied",
            "deferred"
          ]
        },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticEvidence": {
          "$ref": "#/$defs/semanticEvidence"
        },
        "routeEvidence": {
          "$ref": "#/$defs/routeEvidence"
        },
        "branchActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targetStateOwnerNotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenShortcuts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sessionBattleEntryTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "title",
        "status",
        "sourcePaths",
        "semanticEvidence",
        "routeEvidence",
        "branchActions",
        "acceptance",
        "targetStateOwnerNotes",
        "forbiddenShortcuts",
        "verification"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "blocked",
            "ready",
            "applied",
            "deferred"
          ]
        },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticEvidence": {
          "$ref": "#/$defs/semanticEvidence"
        },
        "routeEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/routeEvidence"
          }
        },
        "branchActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targetStateOwnerNotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenShortcuts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "settlementRestOwnerTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "title",
        "status",
        "sourcePaths",
        "semanticEvidence",
        "routeEvidence",
        "branchActions",
        "acceptance",
        "targetStateOwnerNotes",
        "forbiddenShortcuts",
        "verification"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "blocked",
            "ready",
            "applied",
            "deferred"
          ]
        },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticEvidence": {
          "$ref": "#/$defs/semanticEvidence"
        },
        "routeEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/routeEvidence"
          }
        },
        "branchActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targetStateOwnerNotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenShortcuts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
