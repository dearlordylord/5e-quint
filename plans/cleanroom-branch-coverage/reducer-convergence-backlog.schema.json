        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sampledInputWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branchAction",
        "pickName",
        "protocol"
      ],
      "properties": {
        "branchAction": {
          "type": "string",
          "minLength": 1
        },
        "pickName": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semanticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driverPath",
        "ownerPath",
        "projection",
        "comparator"
      ],
      "properties": {
        "driverPath": {
          "type": "string",
          "pattern": "^packages/(battle-runtime|character-battle-runtime|character-creation-runtime|character-sheet-runtime)/.+\\.mbt\\.qnt$"
        },
        "ownerPath": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "const": "qState"
        },
        "comparator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "routeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectorPath",
        "projection",
        "comparator"
      ],
      "properties": {
        "connectorPath": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "const": "qRoute"
        },
        "comparator": {
          "const": "route-event-list"
        }
      }
