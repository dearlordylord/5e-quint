COMPOSE_PROJECT_NAME=dnd-oracle-production
DND_MCP_ENVIRONMENT=production
DND_MCP_DOMAIN=oracle.example.test
DND_MCP_PUBLISHER_NAME=replace-with-verified-publisher-name
DND_MCP_LOOPBACK_PORT=28787
DND_MCP_CADDY_CONFIG_DIRECTORY=/etc/caddy/conf.d
DND_MCP_OPERATIONS_DIRECTORY=/opt/dnd-oracle-operations
DND_MCP_SYSTEMD_DIRECTORY=/etc/systemd/system
DND_MCP_IMAGE=registry.example.test/dnd-oracle@sha256:replace-with-image-digest
DND_MCP_RELEASE=replace-with-git-commit
DND_MCP_STATE_DIRECTORY=/var/lib/dnd-oracle/production
DND_MCP_RELEASE_DIRECTORY=/var/lib/dnd-oracle-releases/production
DND_MCP_MEMORY_LIMIT=1G
DND_MCP_METRICS_TOKEN=replace-with-secret
DND_OPENAI_APPS_CHALLENGE=
DND_OAUTH_RESOURCE_URL=
DND_OAUTH_AUTHORIZATION_SERVER=
DND_OAUTH_ISSUER=
DND_OAUTH_JWKS_URL=
DND_MCP_BUDGET_ALERT_RECIPIENT=replace-with-operator-contact
DND_MCP_FIXED_HOST_MONTHLY_USD=replace-with-number
DND_MCP_PUBLICATION_MODE=disabled
