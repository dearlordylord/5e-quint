# Copy these values into the Glama deployment's encrypted environment settings.
# Do not commit the filled-in values or use this file as a production .env file.

DND_MCP_ENVIRONMENT=staging
DND_MCP_RELEASE=replace-with-the-40-character-git-commit
DND_MCP_PUBLISHER_NAME=replace-with-publisher-name
DND_MCP_PUBLIC_ORIGIN=https://replace-with-an-origin-that-routes-the-whole-app
DND_MCP_HOST=0.0.0.0
PORT=8787

# Glama's persistent volume is mounted at /data.
DND_PLAY_SESSION_DATABASE_PATH=/data/play-sessions.sqlite
DND_SAVED_SESSION_AUTHORIZATION_DATABASE_PATH=/data/saved-session-authorization.sqlite
DND_SAVED_SESSION_AUTHORIZATION_SECRET=replace-with-at-least-32-random-characters

# These four values are required by the public publisher/observability boundary.
DND_MCP_HOSTING_RECIPIENTS=replace-with-hosting-operator,replace-with-ingress-operator
DND_MCP_STDERR_RETENTION=replace-with-retention-period
DND_MCP_INGRESS_ACCESS_LOG_RETENTION=replace-with-retention-period
DND_MCP_BUDGET_MONITORING=disabled

# Optional, but recommended for private testing and operational checks.
DND_MCP_METRICS_TOKEN=replace-with-secret
DND_MCP_BUDGET_ALERT_RECIPIENT=
DND_OPENAI_APPS_CHALLENGE=
