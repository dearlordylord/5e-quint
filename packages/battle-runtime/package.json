{
  "name": "@dnd/battle-runtime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:mbt:creature-attack": "vitest run src/creature-attack.mbt.test.ts",
    "test:mbt:flaming-sphere-hazard-ram": "vitest run src/flaming-sphere-hazard-ram.mbt.test.ts",
    "test:mbt:mirror-image-hit-interception": "vitest run src/mirror-image-hit-interception.mbt.test.ts",
    "test:mbt:moonbeam-movable-zone": "vitest run src/moonbeam-movable-zone.mbt.test.ts",
    "test:mbt:warding-bond-damage-sharing": "vitest run src/warding-bond-damage-sharing.mbt.test.ts",
    "test:mbt:rule-core-hit-point-damage": "vitest run src/rule-core-hit-point-damage.mbt.test.ts",
    "test:mbt:rule-core-features": "vitest run src/rule-core-features.mbt.test.ts",
    "test:mbt:rule-core-movement": "vitest run src/rule-core-movement.mbt.test.ts",
    "test:mbt:rule-core-reactions": "vitest run src/rule-core-reactions.mbt.test.ts",
    "test:mbt:rule-core-stat-block-controls": "vitest run src/rule-core-stat-block-controls.mbt.test.ts",
    "test:mbt:rule-core-spells": "vitest run src/rule-core-spells.mbt.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd/shared": "workspace:*",
    "@dnd/shared-algebras": "workspace:*",
    "@dnd/surface": "workspace:*",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@firfi/quint-connect": "^2.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
