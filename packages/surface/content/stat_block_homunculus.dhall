in  { challengeRating = 0, id = "stat_block_homunculus", kind = "statBlock", name = "Homunculus", provenance = { kind = "srd-5.2.1", section = "Monsters/Monsters-H-L.md:253-276" }, statBlock = { abilityScores = { str = 4, dex = 15, con = 14, int = 10, wis = 10, cha = 7 }, ac = { value = { kind = "literal", value = 13 } }, actions = [ T.textOnly { procedureOrdinal = 1, name = "Bite", description = "Melee Attack Roll: +4, reach 5 ft. Hit: 1 Piercing damage, and the target is subjected to the following effect. Constitution Saving Throw: DC 12. Failure: The target has the Poisoned condition until the end of the homunculus's next turn. Failure by 5 or More: The target has the Poisoned condition for 1 minute. While Poisoned, the target has the Unconscious condition, which ends early if the target takes any damage.", reason = "unsupported_action_shape" } ], traits = [ T.trait { name = "Telepathic Bond", description = "While the homunculus is on the same plane of existence as its master, the two of them can communicate telepathically with each other.", effectKind = None Text } ], alignment = { order = "neutral", morality = "neutral" }, communication = { kind = "understood_but_cannot_speak", languages = { kind = "named_plus_other_languages", languages = [ "Common" ], additionalLanguages = 1 } }, creatureType = "construct", hp = { kind = "literal", value = 4 }, initiative = { modifier = +2, score = 12 }, passivePerception = 10, savingThrowModifiers = [ { ability = "str", modifier = -3 }, { ability = "dex", modifier = +2 }, { ability = "con", modifier = +2 }, { ability = "int", modifier = +0 }, { ability = "wis", modifier = +2 }, { ability = "cha", modifier = +0 } ], immunities = { damageTypes = Some [ "poison" ], conditions = Some [ "charmed", "poisoned" ] }, senses = [ { kind = "darkvision", rangeFeet = 60, qualifier = None Text } ], size = "tiny", speeds = [ { kind = "walk", feet = { kind = "literal", value = 20 }, hover = None Bool }, { kind = "fly", feet = { kind = "literal", value = 40 }, hover = None Bool } ] } }
