in  { challengeRating = 5, id = "stat_block_gladiator", kind = "statBlock", name = "Gladiator", provenance = { kind = "srd-5.2.1", section = "Monsters/Monsters-E-G.md:627-656" }, statBlock = { abilityScores = { str = 18, dex = 15, con = 16, int = 10, wis = 12, cha = 15 }, ac = { value = { kind = "literal", value = 16 } }, actions = [ T.textOnly { procedureOrdinal = 1, name = "Multiattack", description = "The gladiator makes three Spear attacks. It can replace one attack with a use of Shield Bash.", reason = "unsupported_action_shape" }, T.textOnly { procedureOrdinal = 2, name = "Spear", description = "Melee or Ranged Attack Roll: +7, reach 5 ft. or range 20/60 ft. Hit: 11 (2d6 + 4) Piercing damage.", reason = "unsupported_action_shape" }, T.textOnly { procedureOrdinal = 3, name = "Shield Bash", description = "Strength Saving Throw: DC 15, one creature within 5 feet that the gladiator can see. Failure: 9 (2d4 + 4) Bludgeoning damage. If the target is a Medium or smaller creature, it has the Prone condition.", reason = "unsupported_action_shape" } ], reactions = [ T.textOnly { procedureOrdinal = 1, name = "Parry", description = "Trigger: The gladiator is hit by a melee attack roll while holding a weapon. Response: The gladiator adds 3 to its AC against that attack, possibly causing it to miss.", reason = "unsupported_action_shape" } ], alignment = { order = "neutral", morality = "neutral" }, communication = { kind = "spoken_and_understood", languages = { kind = "named", languages = [ "Common" ] } }, creatureType = "humanoid", hp = { kind = "literal", value = 112 }, initiative = { modifier = +5, score = 15 }, passivePerception = 11, savingThrowModifiers = [ { ability = "str", modifier = +7 }, { ability = "dex", modifier = +5 }, { ability = "con", modifier = +6 } ], skillModifiers = [ { skill = "athletics", modifier = 10 }, { skill = "performance", modifier = 5 } ], gear = [ { item = "Shield", quantity = None Natural }, { item = "Spear", quantity = Some 3 }, { item = "S