in  { challengeRating = 0.5, id = "stat_block_hobgoblin_warrior", kind = "statBlock", name = "Hobgoblin Warrior", provenance = { kind = "srd-5.2.1", section = "Monsters/Monsters-H-L.md:193-218" }, statBlock = { abilityScores = { str = 13, dex = 12, con = 12, int = 10, wis = 10, cha = 9 }, ac = { value = { kind = "literal", value = 18 } }, actions = [ T.textOnly { procedureOrdinal = 1, name = "Longsword", description = "Melee Attack Roll: +3, reach 5 ft. Hit: 12 (2d10 + 1) Slashing damage.", reason = "unsupported_action_shape" }, T.textOnly { procedureOrdinal = 2, name = "Longbow", description = "Ranged Attack Roll: +3, range 150/600 ft. Hit: 5 (1d8 + 1) Piercing damage plus 7 (3d4) Poison damage.", reason = "unsupported_action_shape" } ], traits = [ T.trait { name = "Pack Tactics", description = "The hobgoblin has Advantage on an attack roll against a creature if at least one of the hobgoblin's allies is within 5 feet of the creature and the ally doesn't have the Incapacitated condition.", effectKind = Some "attack_roll_advantage_when_non_incapacitated_ally_within_5_feet_of_target" } ], alignment = { order = "lawful", morality = "evil" }, communication = { kind = "spoken_and_understood", languages = { kind = "named", languages = [ "Common", "Goblin" ] } }, creatureType = "fey", creatureTypeTags = [ "goblinoid" ], gear = [ { item = "Half Plate Armor", quantity = None Natural }, { item = "Longbow", quantity = None Natural }, { item = "Longsword", quantity = None Natural }, { item = "Shield", quantity = None Natural } ], hp = { kind = "literal", value = 11 }, initiative = { modifier = +3, score = 13 }, passivePerception = 10, savingThrowModifiers = [ { ability = "str", modifier = +1 }, { ability = "dex", modifier = +1 }, { ability = "con", modifier = +1 }, { ability = "int", modifier = +0 }, { ability = "wis", modifier = +0 }, { ability = "cha", modifier = -1 } ], senses = [ { kind = "darkvision", rangeFeet = 60, qualifier = None Text } ], size = "medium", speeds = [ {