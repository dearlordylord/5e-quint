in  { challengeRating = 6, id = "stat_block_invisible_stalker", kind = "statBlock", name = "Invisible Stalker", provenance = { kind = "srd-5.2.1", section = "Monsters/Monsters-H-L.md:458-489" }, statBlock = { abilityScores = { str = 16, dex = 19, con = 14, int = 10, wis = 15, cha = 11 }, ac = { value = { kind = "literal", value = 14 } }, actions = [ T.textOnly { procedureOrdinal = 1, name = "Multiattack", description = "The stalker makes three Wind Swipe attacks. It can replace one attack with a use of Vortex.", reason = "unsupported_action_shape" }, T.executable { procedureOrdinal = 2, procedure = T.meleeAttack { name = "Wind Swipe", attackAbility = "dex", attackBonus = +7, reachFeet = 5, onHit = { first = T.damage { damageType = "force", dice = 2, dieSize = 6, flat = Some +4, static = 11 }, rest = [  ] : List T.Effect } } }, T.textOnly { procedureOrdinal = 3, name = "Vortex", description = "Constitution Saving Throw: DC 14, one Large or smaller creature in the stalker's space. Failure: 7 (1d8 + 3) Thunder damage, and the target has the Grappled condition (escape DC 13). Until the grapple ends, the target can't cast spells with a Verbal component and takes 7 (2d6) Thunder damage at the start of each of the stalker's turns.", reason = "unsupported_action_shape" } ], traits = [ T.trait { name = "Air Form", description = "The stalker can enter an enemy's space and stop there. It can move through a space as narrow as 1 inch without expending extra movement to do so.", effectKind = None Text }, T.trait { name = "Invisibility", description = "The stalker has the Invisible condition.", effectKind = None Text } ], alignment = { order = "neutral", morality = "neutral" }, communication = { kind = "spoken_and_understood", languages = { kind = "named", languages = [ "Common", "Primordial (Auran)" ] } }, creatureType = "elemental", hp = { kind = "literal", value = 97 }, initiative = { modifier = +7, score = 22 }, passivePerception = 18, savingThrowModifiers = [ { ability = "str", modifier = +3 }, { ability = "dex", modifier = +4 }, { ability = "con", modifier = +2 }, { ability = "int", modifier = +0 }, { ability = "wis", modifier = +2 }, { ability = "cha", modifier = +0 } ], skillModifiers = [ { skill = "perception", modifier = 8 }, { skill = "stealth", modifier = 10 } ], resistances = { kind = "fixed", damageTypes = [ "bludgeoning", "piercing", "slashing" ] }, immunities = { damageTypes = Some [ "poison" ], conditions = Some [ "exhaustion", "grappled", "paralyzed", "petrified", "poisoned", "prone", "restrained", "unconscious" ] }, senses = [ { kind = "darkvision", rangeFeet = 60, qualifier = None Text } ], size = "large", speeds = [ { kind = "walk", feet = { kind = "literal", value = 50 }, hover = None Bool }, { kind = "fly", feet = { kind = "literal", value = 50 }, hover = Some True } ] } }
