{
  "name": "@dnd/surface",
  "private": true,
  "dndWorkspacePackageKind": "production",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./surface/character-creation-readers": "./src/surface/character-creation-readers.ts",
    "./surface/druid-wild-shape-readers": "./src/surface/druid-wild-shape-readers.ts",
    "./surface/find-familiar-forms": "./src/surface/find-familiar-forms.ts",
    "./surface/portable-surface": "./src/surface/portable-surface.ts",
