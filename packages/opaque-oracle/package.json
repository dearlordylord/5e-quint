{
  "name": "@dnd/opaque-oracle",
  "private": true,
  "dndWorkspacePackageKind": "production",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "opaque-oracle": "./dist/oracle.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "check:schema-sync": "tsx scripts/check-schema-sync.ts",
    "generate:corpus": "tsx scripts/oracle-evaluation-cli.ts generate",
    "check:corpus": "tsx scripts/oracle-evaluation-cli.ts check",
    "write:corpus": "tsx scripts/oracle-evaluation-cli.ts write",
    "build": "tsx scripts/build-distribution.ts",
    "check-distribution": "tsx scripts/check-distribution.ts",
    "check:distribution": "pnpm run check-distribution",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd/battle-runtime": "workspace:*",
    "@dnd/character-creation-runtime": "workspace:*",
    "@dnd/character-battle-runtime": "workspace:*",
    "@dnd/character-sheet-runtime": "workspace:*",
    "@dnd/shared": "workspace:*",
    "@dnd/surface": "workspace:*",
    "@effect/platform-node": "4.0.0-rc.112",
    "ajv": "^8.18.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "0.27.4",
    "fast-check": "3.23.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
