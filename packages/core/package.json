{
  "name": "@dnd/core",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "lint": "eslint --no-inline-config -c eslint.config.mjs src && prettier --check src && jscpd src --threshold 2 --ignore \"**/*.test.ts,**/*.mbt.test.ts,**/spell-registry.ts,**/mbt-shared.ts,**/monster-catalog-centaurs.ts,**/monster-catalog-goblins.ts,**/monster-catalog-pseudodragons.ts,**/monster-catalog-humanoids.ts,**/monster-catalog-expanded.ts\"",
    "circular": "madge --extensions ts --circular src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:legacy-battle-mbt": "RUN_LEGACY_CORE_BATTLE_MBT=1 vitest run src/battle-machine.mbt.test.ts src/battle-projection.mbt.test.ts"
  },
  "dependencies": {
    "@dnd/shared": "workspace:*",
    "@dnd/shared-algebras": "workspace:*",
    "@dnd/surface": "workspace:*",
    "@firfi/quint-connect": "^2.0.0",
    "@statelyai/graph": "^0.8.0",
    "@statelyai/inspect": "^0.4.0",
    "effect": "^3.21.0",
    "three": "^0.183.2",
    "xstate": "^5.28.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/three": "^0.183.1",
    "@vitest/coverage-v8": "^3.0.5",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }
}
