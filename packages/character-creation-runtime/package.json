{
  "name": "@dnd/character-creation-runtime",
  "private": true,
  "dndWorkspacePackageKind": "production",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "test": "vitest run --exclude \"**/*.mbt.test.ts\"",
    "test:qnt-slice": ". ../../scripts/resource-lock-owner.sh && with_resource_lock_owner ../../scripts/with-mbt-lock.sh pnpm run test:qnt-slice:body",
    "test:qnt-slice:body": "../../scripts/assert-resource-lock.sh mbt && vitest run src/index.test.ts -t \"character creation QNT slice parity\"",
    "test:qnt-proofs": ". ../../scripts/resource-lock-owner.sh && with_resource_lock_owner ../../scripts/with-mbt-lock.sh pnpm run test:qnt-proofs:body",
    "test:qnt-proofs:body": "../../scripts/assert-resource-lock.sh mbt && RUN_QNT_PROOFS=1 vitest run src/character-creation-runtime-qnt-proofs.test.ts",
    "test:mbt:weapon-mastery-level-gain": ". ../../scripts/resource-lock-owner.sh && with_resource_lock_owner ../../scripts/with-mbt-lock.sh vitest run src/weapon-mastery-level-gain.mbt.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd/shared": "workspace:*",
    "@dnd/shared-algebras": "workspace:*",
    "@dnd/surface": "workspace:*",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@firfi/quint-connect": "catalog:",
    "@types/node": "^22.10.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "fast-check": "3.23.2",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5",
    "zod": "^4.3.6"
  }
}
