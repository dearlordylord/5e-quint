{
  "name": "@dnd/character-sheet-runtime",
  "private": true,
  "dndWorkspacePackageKind": "production",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./consumer-protocol": "./src/consumer-protocol.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "audit:split": "node ../../scripts/audit-character-sheet-runtime-split.mjs",
    "quality": "pnpm audit:split && pnpm typecheck && pnpm test",
    "test:mbt:weapon-mastery-class-level-reselection": ". ../../scripts/resource-lock-owner.sh && with_resource_lock_owner ../../scripts/with-mbt-lock.sh vitest run src/weapon-mastery-class-level-reselection.mbt.test.ts",
    "test:mbt:spell-access-free-cast": ". ../../scripts/resource-lock-owner.sh && with_resource_lock_owner ../../scripts/with-mbt-lock.sh vitest run src/spell-access-free-cast.mbt.test.ts",
    "test": "vitest run --exclude \"**/*.mbt.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd/character-creation-runtime": "workspace:*",
    "@dnd/shared": "workspace:*",
    "@dnd/shared-algebras": "workspace:*",
    "@dnd/surface": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@firfi/quint-connect": "catalog:",
    "ajv": "^8.18.0",
    "@types/node": "22.19.15",
    "@typescript/native": "npm:typescript@^7.0.2",
    "fast-check": "3.23.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
