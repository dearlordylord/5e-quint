  },
  "devDependencies": {
    "@firfi/quint-connect": "catalog:",
    "@types/node": "22.19.15",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
