{
  "name": "@dnd/shared-algebras",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./initiative-algebra": "./src/initiative-algebra.ts",
    "./conditions-algebra": "./src/conditions-algebra.ts",
    "./death-saves-algebra": "./src/death-saves-algebra.ts",
    "./armor-class-algebra": "./src/armor-class-algebra.ts",
    "./action-economy-algebra": "./src/action-economy-algebra.ts",
    "./ability-score-algebra": "./src/ability-score-algebra.ts",
    "./attack-roll-algebra": "./src/attack-roll-algebra.ts",
    "./elapsed-time-algebra": "./src/elapsed-time-algebra.ts",
    "./stable-recovery-algebra": "./src/stable-recovery-algebra.ts",
    "./runtime-dice-algebra": "./src/runtime-dice-algebra.ts",
    "./runtime-hole-algebra": "./src/runtime-hole-algebra.ts",
    "./spell-save-gate-algebra": "./src/spell-save-gate-algebra.ts",
    "./spell-slot-expenditure-algebra": "./src/spell-slot-expenditure-algebra.ts",
    "./zero-hit-point-replacement-algebra": "./src/zero-hit-point-replacement-algebra.ts",
    "./validation-algebra": "./src/validation-algebra.ts",
    "./character-advancement-algebra": "./src/character-advancement-algebra.ts",
    "./speed-algebra": "./src/speed-algebra.ts",
    "./movement-cost-algebra": "./src/movement-cost-algebra.ts",
    "./multiclass-prerequisite-algebra": "./src/multiclass-prerequisite-algebra.ts",
    "./martial-arts-algebra": "./src/martial-arts-algebra.ts",
    "./companion-protocol-algebra": "./src/companion-protocol-algebra.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.mbt.test.ts\"",
    "test:qnt-proofs": "../../scripts/with-mbt-lock.sh pnpm run test:qnt-proofs:body",
    "test:qnt-proofs:body": "../../scripts/assert-resource-lock.sh mbt && RUN_QNT_PROOFS=1 vitest run src/shared-algebras-qnt-proofs.test.ts",
    "test:deterministic": "vitest run src/ability-score-algebra.test.ts src/character-advancement-algebra.test.ts src/multiclass-prerequisite-algebra.test.ts src/movement-cost-algebra.test.ts src/reducer-algebras.test.ts src/spell-save-gate-algebra.test.ts src/spell-slot-expenditure-algebra.test.ts src/speed-algebra.test.ts",
    "test:mbt": "../../scripts/with-mbt-lock.sh vitest run src/reducer-algebras.mbt.test.ts",
    "proof:inductive": "../../scripts/with-mbt-lock.sh pnpm run proof:inductive:body",
    "proof:inductive:body": "../../scripts/assert-resource-lock.sh mbt && RUN_QNT_INDUCTIVE_PROOFS=1 vitest run src/shared-algebras-inductive-proofs.test.ts",
    "proof:initiative": "../../scripts/with-mbt-lock.sh pnpm run proof:initiative:body",
    "proof:initiative:body": "../../scripts/assert-resource-lock.sh mbt && pnpm exec quint run proofs/initiative-algebra-invariant.qnt --invariant invariant --max-samples 2000 --max-steps 40",
    "proof:quint": "../../scripts/with-mbt-lock.sh pnpm run proof:quint:body",
    "proof:quint:body": "../../scripts/assert-resource-lock.sh mbt && pnpm run test:qnt-proofs:body && pnpm run proof:inductive:body && pnpm run proof:initiative:body"
  },
  "dependencies": {
    "@dnd/shared": "workspace:*",
    "@dnd/surface": "workspace:*",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@firfi/quint-connect": "^2.0.0",
    "@types/node": "^22.10.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  }
}
