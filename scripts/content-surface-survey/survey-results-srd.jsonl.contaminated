{"unit_slug":"bane","verdict":"surface_widening","typecheck_exit":0,"tracer_exit":0,"harness_atoms":["action_quota","activate","concentrate","concentration_lock","expire","modify_roll_numeric","scale_target_count","spell_root","spell_slot","target"],"harness_relations":["attaches_to","consumes","grants","modifies","persists_until","roots"],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"surface_widening","claude_proposed_widenings":[{"kind":"new_variant","name":"Effect.ongoing_roll_modifier","justification":"Bane's cast-time Charisma save gates which targets receive the ongoing -1d4 debuff. The activation family's save_gate phase expresses this conditional via onFail: Effect, but Effect = DamageEffect | NoneEffect — there is no variant for 'apply a persistent roll modifier'. Without it, a save_gate phase cannot produce an ongoing modifier effect, so the save gate cannot be encoded at all.","evidence":"Whenever a target that fails this save makes an attack roll or a saving throw before the spell ends, the target must subtract 1d4 from the attack roll or save."}],"claude_confidence":"high","discrepancies":[],"typecheck_stderr":"","tracer_stderr":"","wall_seconds":1.355}

