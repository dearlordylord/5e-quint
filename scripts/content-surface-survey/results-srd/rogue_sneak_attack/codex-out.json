import type {
  UnitRecord,
  SpellRecord,
  ClassFeatureRecord,
  MasteryRecord,
  SpellMechanics,
  OngoingEffectMechanics,
  ActivationMechanics,
  ActivationPhase,
  CastingTime,
  Duration,
  Range,
  Attachment,
  Effect,
  OngoingOperation,
