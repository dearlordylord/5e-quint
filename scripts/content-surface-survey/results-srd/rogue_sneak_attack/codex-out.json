function traceMasteryUnit(mastery: MasteryRecord): Trace {
  const nodes: TraceNode[] = [];
  const edges: TraceEdge[] = [];
  const ids = idGen();

  const rootId = ids("root");
  nodes.push({
    id: rootId,
    category: "source",
    atomKind: "mastery_root",
    label: `mastery_root\n${mastery.name}`,
  });

