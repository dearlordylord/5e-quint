/workspace/typescript/dnd/scripts/content-surface-survey/results-srd/magic_item_rope_of_entanglement/verdict.json:1:{"unit_slug":"magic_item_rope_of_entanglement","verdict":"structural_widening","typecheck_exit":-1,"tracer_exit":-1,"harness_atoms":[],"harness_relations":[],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"structural_widening","claude_proposed_widenings":[{"kind":"new_variant","name":"MagicItemMechanics.ongoing_effect","justification":"The rope is activated with a Magic action, but its core effect persists as an active restraint with later release and escape handling. The current magic-item surface only allows passive or one-shot activation mechanics.","evidence":"The target must succeed on a DC 15 Dexterity saving throw or have the Restrained condition."},{"kind":"new_subgraph","name":"bound_item_escape_loop","justification":"A restrained target gets its own action-based escape attempt against fixed DC 15, choosing between two different skill-based ability checks, and success ends only this rope-bound restraint.","evidence":"A target Restrained by the rope can take an action to make its choice of a DC 15 Strength (Athletics) or Dexterity (Acrobatics) check. On a successful check, the target is no longer Restrained by the rope."},{"kind":"new_subgraph","name":"item_object_state_and_lifecycle","justification":"The rope itself has combat-facing object stats, passive regeneration on a timed cadence, location changes depending on who is holding it, and deterministic destruction at 0 HP. That is item-owned runtime state, not a simple rider on the restrained target.","evidence":"The rope has AC 20, HP 20, and Immunity to Poison and Psychic damage. It regains 1 Hit Point every 5 minutes as long as it has at least 1 Hit Point. If the rope drops to 0 Hit Points, it is destroyed."}],"claude_confidence":"high","discrepancies":["no content/magic_item_rope_of_entanglement.json authored; accepted self-report-only widening path"],"typecheck_stderr":"