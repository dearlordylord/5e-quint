/workspace/typescript/dnd/scripts/content-surface-survey/results-srd/magic_item_dagger_of_venom/verdict.json:1:{"unit_slug":"magic_item_dagger_of_venom","verdict":"structural_widening","typecheck_exit":-1,"tracer_exit":-1,"harness_atoms":[],"harness_relations":[],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"structural_widening","claude_proposed_widenings":[{"kind":"new_subgraph","name":"MagicItemRecord","justification":"No magic_item kind exists in UnitRecord. The union only covers spell, class_feature, and mastery. Magic items require their own top-level record kind with distinct mechanics families (passive item properties, activated item charges, etc.).","evidence":"Weapon (Dagger), Rare — this is a magic item, not a spell, class feature, or mastery."},{"kind":"new_variant","name":"RestResetCadence: dawn","justification":"The dagger's poison coating resets at next dawn, which is not covered by short_rest, long_rest, short_or_long_rest, or partial_short_full_long.","evidence":"The weapon can't be used this way again until the next dawn."},{"kind":"new_variant","name":"Condition: poisoned","justification":"The save gate on-fail result applies the Poisoned condition, but the Condition type currently only supports 'prone'.","evidence":"That creature must succeed on a DC 15 Constitution saving throw or take 2d10 Poison damage and have the Poisoned condition for 1 minute."},{"kind":"new_variant","name":"DcSource: fixed","justification":"The poison save uses a fixed DC 15 — not caster_spell_save_dc (no caster) and not weapon_attack_dc (which is 8 + ability mod + PB). A fixed numeric DC is a distinct variant.","evidence":"That creature must succeed on a DC 15 Constitution saving throw."}],"claude_confidence":"high","discrepancies":["no content/magic_item_dagger_of_venom.json authored; accepted self-report-only widening path"],"typecheck_stderr":"","tracer_stderr":"","wall_seconds":0}
