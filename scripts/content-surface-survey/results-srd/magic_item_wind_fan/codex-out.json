/workspace/typescript/dnd/scripts/content-surface-survey/results-srd/magic_item_sword_of_life_stealing/codex-out.json:7141:../../survey-results-srd.jsonl:391:{"unit_slug":"feat_boon_of_spell_recall","verdict":"structural_widening","typecheck_exit":-1,"tracer_exit":-1,"harness_atoms":[],"harness_relations":[],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"structural_widening","claude_proposed_widenings":[{"kind":"new_subgraph","name":"FeatRecord","justification":"UnitRecord in types.ts has no 'feat' kind. SpellRecord | ClassFeatureRecord | MasteryRecord is the exhaustive union; feat_root exists in the v4 taxonomy atom inventory but has never been given a corresponding surface record type.","evidence":"Epic Boon Feat (Prerequisite: Level 19+, Spellcasting Feature)"},{"kind":"new_subgraph","name":"passive_spell_cast_trigger","justification":"Free Casting fires passively on every spell cast with a L1-4 slot \u2014 not an activation. The existing activation family requires an explicit activation cost. A passive trigger on spell_cast_window needs a new feat/feature family (analogous to on_hit_trigger for masteries but keyed to spell-casting events).","evidence":"Whenever you cast a spell with a level 1\u20134 spell slot, roll 1d4."},{"kind":"new_subgraph","name":"probabilistic_roll_gate","justification":"The check is: roll 1d4, compare result to slot level (a runtime parameter). No surface type models a probabilistic check against a dynamic integer parameter. This is structurally distinct from save_gate (ability check, fixed DC) and attack_roll (vs AC). It needs a new resolution shape.","evidence":"roll 1d4. If the number you roll is the same as the slot's level, the slot isn't expended."},{"kind":"new_variant","name":"refund_spell_slot","justification":"The effect on a successful check is that the spell slot is not expended \u2014 a conditional resource refund. The v4 taxonomy lists 'refund' as a procedure atom, but types.ts has no surface variant for it. The closest effect in ClassFeatureEffect is grant_extra_action or heal_hp; neither represents a slot refund.","evidence":"the slot isn't expended"}],"claude_confidence":"high","discrepancies":["no content/feat_boon_of_spell_recall.json authored; accepted self-report-only widening path"],"typecheck_stderr":"","tracer_stderr":"","wall_seconds":0}
/workspace/typescript/dnd/scripts/content-surface-survey/results-srd/magic_item_sword_of_life_stealing/codex-out.json:7152:../../survey-results-srd.jsonl:771:{"unit_slug":"magic_item_figurine_of_wondrous_power","verdict":"structural_widening","typecheck_exit":-1,"tracer_exit":-1,"harness_atoms":[],"harness_relations":[],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"structural_widening","claude_proposed_widenings":[{"kind":"new_subgraph","name":"MagicItemRecord + magic_item family","justification":"UnitRecord has no magic_item kind. The taxonomy lists magic_item_root as a source atom but types.ts has no MagicItemRecord, no MagicItemMechanics, and no mechanics family to house it. Every existing family (activation, ongoing_effect, on_hit_trigger, anchored_trigger, triggered_reaction) is incompatible with item semantics.","evidence":"If you take a Magic action to throw the figurine to a point on the ground within 60 feet of yourself, the figurine becomes a living creature... The creature exists for a duration specific to each figurine. At the end of the duration, the creature reverts to its figurine form... its property can't be used again until a certain amount of time has passed."},{"kind":"new_variant","name":"day_cooldown variant of RestResetCadence (or new ItemRechargeKind)","justification":"Figurine recharge is measured in days (2, 5, 7, 15, 30 days) \u2014 not short/long rest. RestResetCadence has no variant for calendar-time recharge. A new closed type (e.g. DayCooldown { days: number }) is needed.","evidence":"Once it has been used, it can't be used again until 5 days have passed. / Once it has been used, it can't be used again until 2 days have passed."},{"kind":"new_variant","name":"charge_pool with day-recharge (Goat of Traveling pattern)","justification":"Goat of Traveling uses a 24-charge pool where each hour of use costs 1 charge and the pool recharges after 7 days when empty. This is neither use_count (fixed cap + rest reset) nor spell_slot. Needs a charge resource with duration-based consumption and day-count recharge.","evidence":"It has 24 charges, and each hour or portion thereof it spends in goat form costs 1 charge. When it runs out of charges, it reverts to a figurine and can't be used again until 7 days have passed, when it regains all expended charges."},{"kind":"new_variant","name":"multi-variant item (one item slug, several named sub-configurations)","justification":"The Figurine of Wondrous Power is a single item category with nine distinct named variants (Bronze Griffon, Ebony Fly, Golden Lions, Ivory Goats \u00d7 3, Marble Elephant, Obsidian Steed, Onyx Dog, Serpentine Owl, Silver Raven). No surface type models this one-to-many item/variant relationship.","evidence":"Bronze Griffon (Rare)... Ebony Fly (Rare)... Golden Lions (Rare)... Ivory Goats (Rare)... Obsidian Steed (Very Rare)... Onyx Dog (Rare)... Serpentine Owl (Rare)... Silver Raven (Uncommon)."},{"kind":"new_subgraph","name":"create_companion mechanics subgraph","justification":"The core effect is summoning a named creature that acts as a friendly companion with initiative placement, obeys commands, and reverts on 0 HP or dismissal. The v4 atom create_companion exists but there is no surface mechanics shape that expresses: throw-to-point activation, creature-kind binding, duration-to-revert lifecycle, or companion command semantics.","evidence":"The creature is Friendly to you and your allies. It understands your languages, obeys your commands, and takes its turn immediately after you on your Initiative count."},{"kind":"new_atom","name":"probabilistic_override (Obsidian Steed 10% disobedience)","justification":"The Obsidian Steed has a 10% per-use chance to ignore all commands including revert. This is not representable by any existing resolution atom (attack_roll, save_gate, ability_check). It requires a probability-weighted override that bypasses the normal command chain.","evidence":"The figurine has a 10 percent chance each time you use it to ignore your orders, including a command to revert to figurine form."}],"claude_confidence":"high","discrepancies":["no content/magic_item_figurine_of_wondrous_power.json authored; accepted self-report-only widening path"],"typecheck_stderr":"","tracer_stderr":"","wall_seconds":0}
