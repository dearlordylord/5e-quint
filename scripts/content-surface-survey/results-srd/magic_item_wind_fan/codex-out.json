/workspace/typescript/dnd/scripts/content-surface-survey/results-srd/magic_item_spell_scroll/codex-out.json:7516:/workspace/typescript/dnd/scripts/content-surface-survey/survey-results-srd.jsonl:1241:{"unit_slug":"rogue_use_magic_device_l13","verdict":"structural_widening","typecheck_exit":-1,"tracer_exit":-1,"harness_atoms":[],"harness_relations":[],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"structural_widening","claude_proposed_widenings":[{"kind":"new_subgraph","name":"passive_trait (ClassFeatureMechanics family)","justification":"Use Magic Device grants three always-on benefits with no activation cost, no use count, and no rest reset cadence. The only existing ClassFeatureMechanics family ('activation') mandates activationCost, resource, and resetCadence. A passive_trait family is required to represent always-on class feature benefits that trigger automatically or are unconditionally active.","evidence":"You've learned how to maximize use of magic items, granting you the following benefits. \u2014 no activation trigger, no uses per rest, no cost stated anywhere in the feature."},{"kind":"new_atom","name":"modify_attunement_cap","justification":"The Attunement benefit extends the character's attunement slot count from 3 to 4. No existing ClassFeatureEffect or v4 effect atom covers a numeric change to the attunement capacity. The v4 atom 'attunement_slot' is a consumed resource, not a cap modifier.","evidence":"You can attune to up to four magic items at once."},{"kind":"new_atom","name":"charge_refund_on_roll","justification":"The Charges benefit introduces a stochastic 'roll 1d6, on 6 do not expend charges' mechanic triggered on each magic item charge expenditure. v4 has 'refund' as a procedure atom but no surface shape for a probabilistic die-gated charge refund. This is mechanically distinct from any existing effect, window, or resource atom \u2014 it requires a die-roll gate concept with no current representation.","evidence":"Whenever you use a magic item property that expends charges, roll 1d6. On a roll of 6, you use the property without expending the charges."},{"kind":"new_atom","name":"grant_scroll_access","justification":"The Scrolls benefit unlocks use of any Spell Scroll with Intelligence as spellcasting ability, plus a level-scaled DC ability check for higher-level scrolls (DC 10 + spell level) and item destruction on failure. v4 has 'grant_spell_access' for class spell list expansion, but no atom covers 'use a physical magic item (scroll) as a spell source with a custom casting ability, gated on a level-dependent ability check, with item destruction on failure'.","evidence":"You can use any Spell Scroll, using Intelligence as your spellcasting ability... If the scroll contains a higher-level spell, you must first succeed on an Intelligence (Arcana) check (DC 10 plus the spell's level). On a failed check, the scroll disintegrates."}],"claude_confidence":"high","discrepancies":["no content/rogue_use_magic_device_l13.json authored; accepted self-report-only widening path"],"typecheck_stderr":"","tracer_stderr":"","wall_seconds":0}
/workspace/typescript/dnd/scripts/content-surface-survey/results-srd/magic_item_spell_scroll/codex-out.json:7569:/workspace/typescript/dnd/scripts/content-surface-survey/results-srd/rogue_use_magic_device_l13/verdict.json:1:{"unit_slug":"rogue_use_magic_device_l13","verdict":"structural_widening","typecheck_exit":-1,"tracer_exit":-1,"harness_atoms":[],"harness_relations":[],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"structural_widening","claude_proposed_widenings":[{"kind":"new_subgraph","name":"passive_trait (ClassFeatureMechanics family)","justification":"Use Magic Device grants three always-on benefits with no activation cost, no use count, and no rest reset cadence. The only existing ClassFeatureMechanics family ('activation') mandates activationCost, resource, and resetCadence. A passive_trait family is required to represent always-on class feature benefits that trigger automatically or are unconditionally active.","evidence":"You've learned how to maximize use of magic items, granting you the following benefits. — no activation trigger, no uses per rest, no cost stated anywhere in the feature."},{"kind":"new_atom","name":"modify_attunement_cap","justification":"The Attunement benefit extends the character's attunement slot count from 3 to 4. No existing ClassFeatureEffect or v4 effect atom covers a numeric change to the attunement capacity. The v4 atom 'attunement_slot' is a consumed resource, not a cap modifier.","evidence":"You can attune to up to four magic items at once."},{"kind":"new_atom","name":"charge_refund_on_roll","justification":"The Charges benefit introduces a stochastic 'roll 1d6, on 6 do not expend charges' mechanic triggered on each magic item charge expenditure. v4 has 'refund' as a procedure atom but no surface shape for a probabilistic die-gated charge refund. This is mechanically distinct from any existing effect, window, or resource atom — it requires a die-roll gate concept with no current representation.","evidence":"Whenever you use a magic item property that expends charges, roll 1d6. On a roll of 6, you use the property without expending the charges."},{"kind":"new_atom","name":"grant_scroll_access","justification":"The Scrolls benefit unlocks use of any Spell Scroll with Intelligence as spellcasting ability, plus a level-scaled DC ability check for higher-level scrolls (DC 10 + spell level) and item destruction on failure. v4 has 'grant_spell_access' for class spell list expansion, but no atom covers 'use a physical magic item (scroll) as a spell source with a custom casting ability, gated on a level-dependent ability check, with item destruction on failure'.","evidence":"You can use any Spell Scroll, using Intelligence as your spellcasting ability... If the scroll contains a higher-level spell, you must first succeed on an Intelligence (Arcana) check (DC 10 plus the spell's level). On a failed check, the scroll disintegrates."}],"claude_confidence":"high","discrepancies":["no content/rogue_use_magic_device_l13.json authored; accepted self-report-only widening path"],"typecheck_stderr":"","tracer_stderr":"","wall_seconds":0}
/workspace/typescript/dnd/scripts/content-surface-survey/results-srd/magic_item_spell_scroll/verdict.json:1:{"unit_slug":"magic_item_spell_scroll","verdict":"structural_widening","typecheck_exit":-1,"tracer_exit":-1,"harness_atoms":[],"harness_relations":[],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"structural_widening","claude_proposed_widenings":[{"kind":"new_subgraph","name":"stored_spell_scroll_payload","justification":"Spell Scroll is not a fixed spell-grant item like a wand or ring. It is a one-shot item that stores one arbitrary spell record, inherits that spell's normal casting time, suppresses Material components, and destroys itself only after a completed cast. The current magic-item activation family only models fixed phases and fixed spell grants authored directly on the item.","evidence":"A Spell Scroll bears the words of a single spell... Casting the spell by reading the scroll requires the spell's normal casting time. Once the spell is cast, the scroll crumbles to dust. If the casting is interrupted, the scroll isn't lost."},{"kind":"new_variant","name":"MagicItemMechanics.embedded_spell_scroll","justification":"The item's rarity, save DC, and attack bonus vary with the embedded spell's level, and the spell itself is not statically known at the item-type level. Existing `passive` and `activation` mechanics require a concrete authored effect sequence or a named `grant_spell_access` target, which would be dishonest for the generic Spell Scroll item.","evidence":"The level of the spell on the scroll determines the spell's saving throw DC and attack bonus, as well as the scroll's rarity..."},{"kind":"new_variant","name":"embedded_spell_cast_gate","justification":"Using the scroll depends on reader state outside the current item grammar: whether the spell is on the reader's spell list, whether its level exceeds what the reader can normally cast, and an ability check with DC `10 + spell level` on that contingent branch only. No existing activation phase can express a reader-capability-gated cast of an embedded arbitrary spell payload.","evidence":"If the spell is on your spell list... Otherwise, the scroll is unintelligible. If the spell is on your spell list but of a higher level than you can normally cast, you make an ability check using your spellcasting ability... The DC equals 10 plus the spell's level."}],"claude_confidence":"high","discrepancies":["no content/magic_item_spell_scroll.json authored; accepted self-report-only widening path"],"typecheck_stderr":"","tracer_stderr":"","wall_seconds":0.001}
