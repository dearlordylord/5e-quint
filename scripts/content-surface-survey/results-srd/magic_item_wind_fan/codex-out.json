/workspace/typescript/dnd/scripts/content-surface-survey/results-srd/magic_item_sword_of_life_stealing/codex-out.json:8739:../../results-srd/feat_boon_of_spell_recall/verdict.json:1:{"unit_slug":"feat_boon_of_spell_recall","verdict":"structural_widening","typecheck_exit":-1,"tracer_exit":-1,"harness_atoms":[],"harness_relations":[],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"structural_widening","claude_proposed_widenings":[{"kind":"new_subgraph","name":"FeatRecord","justification":"UnitRecord in types.ts has no 'feat' kind. SpellRecord | ClassFeatureRecord | MasteryRecord is the exhaustive union; feat_root exists in the v4 taxonomy atom inventory but has never been given a corresponding surface record type.","evidence":"Epic Boon Feat (Prerequisite: Level 19+, Spellcasting Feature)"},{"kind":"new_subgraph","name":"passive_spell_cast_trigger","justification":"Free Casting fires passively on every spell cast with a L1-4 slot — not an activation. The existing activation family requires an explicit activation cost. A passive trigger on spell_cast_window needs a new feat/feature family (analogous to on_hit_trigger for masteries but keyed to spell-casting events).","evidence":"Whenever you cast a spell with a level 1–4 spell slot, roll 1d4."},{"kind":"new_subgraph","name":"probabilistic_roll_gate","justification":"The check is: roll 1d4, compare result to slot level (a runtime parameter). No surface type models a probabilistic check against a dynamic integer parameter. This is structurally distinct from save_gate (ability check, fixed DC) and attack_roll (vs AC). It needs a new resolution shape.","evidence":"roll 1d4. If the number you roll is the same as the slot's level, the slot isn't expended."},{"kind":"new_variant","name":"refund_spell_slot","justification":"The effect on a successful check is that the spell slot is not expended — a conditional resource refund. The v4 taxonomy lists 'refund' as a procedure atom, but types.ts has no surface variant for it. The closest effect in ClassFeatureEffect is grant_extra_action or heal_hp; neither represents a slot refund.","evidence":"the slot isn't expended"}],"claude_confidence":"high","discrepancies":["no content/feat_boon_of_spell_recall.json authored; accepted self-report-only widening path"],"typecheck_stderr":"","tracer_stderr":"","wall_seconds":0}
