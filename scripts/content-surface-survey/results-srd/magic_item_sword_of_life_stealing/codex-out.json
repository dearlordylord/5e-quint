../../survey-results-srd.jsonl:1695:{"unit_slug":"magic_item_staff_of_withering","verdict":"structural_widening","typecheck_exit":-1,"tracer_exit":-1,"harness_atoms":[],"harness_relations":[],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"structural_widening","claude_proposed_widenings":[{"kind":"new_subgraph","name":"magic_item_on_hit_trigger_activation","justification":"The item's core mechanic is an optional charge spend inside a quarterstaff hit window that adds extra damage and opens a saving throw rider. Existing magic-item families only support passive grants or explicit activations, not weapon-hit-triggered item activations.","evidence":"On a hit, it deals damage as a normal Quarterstaff, and you can expend 1 charge to deal an extra 2d10 Necrotic damage to the target and force it to make a DC 15 Constitution saving throw."},{"kind":"new_variant","name":"modify_roll_advantage.abilityCheckAbilityFilter","justification":"The failed-save rider applies to any Strength or Constitution ability check, not just named skills. The current surface can filter saving throws by ability and ability checks by skill, but it cannot express raw ability-based check filtering without losing non-skill checks.","evidence":"On a failed save, the target has Disadvantage for 1 hour on any ability check or saving throw that uses Strength or Constitution."}],"claude_confidence":"high","discrepancies":["no content/magic_item_staff_of_withering.json authored; accepted self-report-only widening path"],"typecheck_stderr":"","tracer_stderr":"","wall_seconds":0}
