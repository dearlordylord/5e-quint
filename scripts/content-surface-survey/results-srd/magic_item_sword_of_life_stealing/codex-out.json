../../results-srd/feat_boon_of_irresistible_offense/verdict.json:1:{"unit_slug":"feat_boon_of_irresistible_offense","verdict":"structural_widening","typecheck_exit":-1,"tracer_exit":-1,"harness_atoms":[],"harness_relations":[],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"structural_widening","claude_proposed_widenings":[{"kind":"new_subgraph","name":"feat_record","justification":"No UnitRecord kind for 'feat' exists. The surface defines only spell, class_feature, and mastery records. A feat is a distinct kind with prerequisites, multiple independent benefit buckets, and no single mechanics family mapping to existing families.","evidence":"Epic Boon Feat (Prerequisite: Level 19+) — grants Ability Score Increase, Overcome Defenses, and Overwhelming Strike as distinct, structurally independent benefits."},{"kind":"new_atom","name":"crit_window","justification":"Overwhelming Strike triggers specifically on a natural 20, not on any hit. The v4 taxonomy explicitly records crit_window as a deferred single-feat pressure case for this exact feat. on_hit_window cannot distinguish a critical hit from an ordinary hit.","evidence":"When you roll a 20 on the d20 for an attack roll, you can deal extra damage to the target equal to the ability score increased by this feat."},{"kind":"new_variant","name":"DiceAmount: ability_score_value","justification":"Overwhelming Strike's damage equals the character's current STR or DEX score (the one boosted by the feat) — a flat integer derived from a runtime stat. No existing DiceAmount variant (fixed, threshold_tiers, linear_per_level) can express a value that references a character ability score.","evidence":"you can deal extra damage to the target equal to the ability score increased by this feat"},{"kind":"new_variant","name":"passive_benefit (bypass_resistance, always-on)","justification":"Overcome Defenses is an always-on passive — no activation, no trigger, no quota consumed. The bypass_resistance v4 atom exists, but the current surface has no passive benefit carrier. All existing ClassFeatureEffect variants are activated effects, not passive always-on modifiers.","evidence":"The Bludgeoning, Piercing, and Slashing damage you deal always ignores Resistance."}],"claude_confidence":"high","discrepancies":["no content/feat_boon_of_irresistible_offense.json authored; accepted self-report-only widening path"],"typecheck_stderr":"","tracer_stderr":"","wall_seconds":0.001}
