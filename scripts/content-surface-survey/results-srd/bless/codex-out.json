function scalingAtomFor(amt: DiceAmount): string {
  if (amt.kind === "fixed") return "scale_numeric_bonus";
  if (amt.kind === "threshold_tiers") {
    const changesDieSize = amt.tiers.some(
      (t) => t.override.dieSize !== undefined,
