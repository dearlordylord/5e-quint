{"unit_slug":"fire_bolt","verdict":"surface_widening","typecheck_exit":0,"tracer_exit":0,"harness_atoms":["action_quota","activate","attack_roll","damage","on_hit_window","scale_die_count","spell_root","target"],"harness_relations":["attaches_to","consumes","grants","modifies","opens_window","roots"],"unknown_atoms":[],"unknown_relations":[],"claude_self_verdict":"surface_widening","claude_proposed_widenings":[{"kind":"new_variant","name":"Effect.apply_condition","justification":"Fire Bolt's secondary effect 'A flammable object hit by this spell starts burning' requires an apply_condition Effect variant in ActivationPhase.onHit. The v4 atom apply_condition exists but Effect in the surface only admits DamageEffect | NoneEffect. Modeling the burning rider requires a new ApplyConditionEffect = { kind: 'apply_condition'; condition: Condition } variant.","evidence":"A flammable object hit by this spell starts {@hazard burning|XPHB} if it isn't being worn or carried."},{"kind":"new_variant","name":"Condition.burning","justification":"SRD 5.2.1 defines 'Burning' as a hazard condition (object/creature acquires the Burning condition on hit; takes 1d4 Fire at turn start). The current Condition type only contains 'prone'. 'burning' is a valid SRD 5.2.1 condition that must be added to the closed Condition set.","evidence":"A flammable object hit by this spell starts {@hazard burning|XPHB} if it isn't being worn or carried."}],"claude_confidence":"high","discrepancies":[],"typecheck_stderr":"","tracer_stderr":"","wall_seconds":1.75}
