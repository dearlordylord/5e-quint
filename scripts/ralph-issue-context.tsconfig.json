{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "ralph-issue-context.ts",
    "ralph-issue-context.test.ts",
    "ralph-issue-context.cli.test.ts",
    "ralph-issue-context.git.integration.test.ts",
    "ralph-issue-context.process.test.ts",
    "ralph-run.test.ts",
    "ralph-issue-context.property.test.ts",
    "ralph-task-index.cjs"
  ]
}
