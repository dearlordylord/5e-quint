{
  "include": [
    "consumer-entry.ts",
    "scenario-character-contract.ts",
    "scenario-setup-contract.ts",
    "../../../packages/battle-runtime/src/index.ts",
    "../../../packages/character-creation-runtime/src/index.ts",
    "../../../packages/character-sheet-runtime/src/index.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": "../../..",
    "paths": {
      "@dnd/battle-runtime": ["packages/battle-runtime/src/index.ts"],
      "@dnd/battle-runtime/consumer-protocol": [
        "packages/battle-runtime/src/consumer-protocol.ts"
      ],
      "@dnd/character-creation-runtime": [
        "packages/character-creation-runtime/src/index.ts"
      ],
      "@dnd/character-creation-runtime/consumer-protocol": [
        "packages/character-creation-runtime/src/consumer-protocol.ts"
      ],
      "@dnd/character-sheet-runtime": [
        "packages/character-sheet-runtime/src/index.ts"
      ],
      "@dnd/character-sheet-runtime/consumer-protocol": [
        "packages/character-sheet-runtime/src/consumer-protocol.ts"
      ],
      "@dnd/scenario-character-sdk": [
        "scripts/raw-swarm/sdk-player/scenario-character-contract.ts"
      ],
      "@dnd/scenario-setup-sdk": [
        "scripts/raw-swarm/sdk-player/scenario-setup-contract.ts"
      ],
      "@dnd/shared/*": ["packages/shared/src/*"],
      "@dnd/shared-algebras/*": ["packages/shared-algebras/src/*"],
      "@dnd/tactical-space": ["packages/tactical-space/src/index.ts"],
      "@dnd/surface/*": ["packages/surface/src/*"]
    },
    "rootDir": "../../..",
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "strict": true,
    "exactOptionalPropertyTypes": true
  }
}
