{
  "include": [
    "**/*.ts",
    "../run-sdk-player.ts",
    "../replay-sdk-player.ts",
    "../report.ts",
    "../review-preflight.ts",
    "../review-scenario.ts",
    "../generate-scenario.ts",
    "../author-scenario-setup.ts",
    "../author-scenario-characters.ts",
    "../examples/*.ts",
    "../scenario-campaign.ts",
    "scenario-setup-contract.ts",
    "scenario-setup-runtime.ts",
    "scenarios/*.setup.ts",
    "../transcript.ts"
  ],
  "exclude": ["**/*.test.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@dnd/player-sdk": ["./consumer-entry.ts"],
      "@dnd/battle-runtime": ["../../../packages/battle-runtime/src/index.ts"],
      "@dnd/character-creation-runtime": [
        "../../../packages/character-creation-runtime/src/index.ts"
      ],
      "@dnd/character-battle-runtime": [
        "../../../packages/character-battle-runtime/src/index.ts"
      ],
      "@dnd/character-sheet-runtime": [
        "../../../packages/character-sheet-runtime/src/index.ts"
      ],
      "@dnd/scenario-character-sdk": ["./scenario-character-contract.ts"],
      "@dnd/scenario-setup-sdk": ["./scenario-setup-contract.ts"],
      "@dnd/shared/*": ["../../../packages/shared/src/*"],
      "@dnd/shared-algebras/*": ["../../../packages/shared-algebras/src/*"],
      "@dnd/tactical-space": ["../../../packages/tactical-space/src/index.ts"],
      "@dnd/surface/*": ["../../../packages/surface/src/*"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
