{
  "include": [
    "check-surface-content-json-sync.ts",
    "check-surface-content-json-sync.test.ts",
    "check-srd-stat-block-catalog.ts",
    "check-srd-stat-block-catalog.test.ts",
    "check-srd-stat-block-aggregate.test.ts",
    "verify-surface-publication-delta.ts",
    "check-surface-stat-block-parity-final.ts",
    "check-surface-stat-block-parity-final.test.ts",
    "generate-surface-publication.ts",
    "generate-srd-stat-block-aggregate.ts",
    "check-srd-stat-block-aggregate.ts",
    "generate-surface-portable-cases.ts",
    "surface-portable-case-oracle.ts",
    "srd-surface-publication-artifacts.ts",
    "srd-stat-block-aggregate.ts",
    "stat-block-procedure-pressure.ts",
    "srd521-stat-block-parity.ts",
    "srd521-stat-block-parity.test.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
